# ── Secrets : jamais sur GitHub ───────────────────────────────────
.env
.env.local
.env.prod
# .env.azure contient les vraies valeurs Azure.
# Le dépôt est privé, mais on le garde hors de git par précaution :
# si le dépôt devenait public, les secrets ne partiraient pas avec.
# Pour le versionner malgré tout : commentez la ligne ci-dessous.
.env.azure

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.Python

# ── Odoo ──────────────────────────────────────────────────────────
/filestore/
/sessions/
*.log
*.pid

# ── Docker ────────────────────────────────────────────────────────
docker-compose.override.yml

# ── IDE / OS ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
