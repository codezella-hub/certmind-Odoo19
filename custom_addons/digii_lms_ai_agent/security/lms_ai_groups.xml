<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Un étudiant ne voit que SES propres conversations -->
        <record id="rule_lms_ai_session_own" model="ir.rule">
            <field name="name">Conversations tuteur : les siennes uniquement</field>
            <field name="model_id" ref="model_digii_lms_ai_chat_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_lms_ai_message_own" model="ir.rule">
            <field name="name">Messages tuteur : les siens uniquement</field>
            <field name="model_id" ref="model_digii_lms_ai_chat_message"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
