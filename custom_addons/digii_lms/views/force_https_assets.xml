<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         CORRECTIF MIXED CONTENT — Azure Container Apps

         Azure ne transmet pas le header X-Forwarded-Proto à Odoo.
         Werkzeug (le serveur HTTP d'Odoo) détermine le schéma depuis
         ce header : sans lui, il construit toutes les URLs en http://,
         même si le client est en HTTPS. Les iframes (PDF, vidéos)
         sont alors bloquées par le navigateur.

         On injecte un script qui remplace http:// par https:// sur
         toutes les iframes, au chargement et dynamiquement.
         ═══════════════════════════════════════════════════════════════ -->
    <template id="force_https_assets"
              inherit_id="website.assets_frontend"
              name="Correctif Mixed Content — iframes HTTPS">
        <xpath expr="." position="inside">
            <script type="text/javascript"
                    src="/digii_lms/static/src/js/force_https.js"/>
        </xpath>
    </template>
</odoo>
