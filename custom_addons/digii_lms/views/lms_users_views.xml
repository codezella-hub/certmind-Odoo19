<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lms_user_form" model="ir.ui.view">
        <field name="name">res.users.lms.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Utilisateur LMS">
                <sheet>

                    <div class="oe_title d-flex align-items-center gap-3">
                        <field name="image_1920" widget="image"
                               class="oe_avatar"
                               options="{'preview_image': 'image_128'}"/>
                        <div>
                            <h1>
                                <field name="name" placeholder="Nom complet"/>
                            </h1>
                        </div>
                    </div>

                    <group>
                        <group string="Informations">
                            <field name="login"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Groupe LMS">
                            <field name="lms_group" widget="radio"/>
                        </group>
                    </group>

                    <!-- Mot de passe -->
                    <group string="Sécurité">
                        <field name="password"
                               string="Mot de passe"
                               password="True"
                               invisible="id != False"/>
                        <field name="new_password"
                               string="Nouveau mot de passe"
                               password="True"/>
                    </group>



                </sheet>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_lms_user_list" model="ir.ui.view">
        <field name="name">res.users.lms.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Utilisateurs LMS">
                <field name="image_128" widget="image"
                       options="{'size': [32,32]}"/>
                <field name="name"/>
                <field name="login"/>
                <field name="email"/>
                <field name="lms_group" widget="badge"
                       decoration-danger="lms_group == 'admin'"
                       decoration-info="lms_group == 'professor'"
                       decoration-success="lms_group == 'student'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_lms_users" model="ir.actions.act_window">
        <field name="name">Utilisateurs LMS</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5,0,0),
            (0,0,{'view_mode':'list','view_id':ref('view_lms_user_list')}),
            (0,0,{'view_mode':'form','view_id':ref('view_lms_user_form')}),
        ]"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>