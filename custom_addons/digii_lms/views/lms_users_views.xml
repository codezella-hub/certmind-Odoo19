<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lms_user_form" model="ir.ui.view">
        <field name="name">res.users.lms.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Utilisateur LMS">
                <sheet>

                    <div class="oe_title d-flex align-items-center gap-3">
                        <field name="image_1920" widget="image"
                               class="oe_avatar"
                               options="{'preview_image': 'image_128'}"/>
                        <div>
                            <h1>
                                <field name="name" placeholder="Nom complet"/>
                            </h1>
                        </div>
                    </div>

                    <group>
                        <group string="Informations">
                            <field name="login"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Type de compte">
                            <!-- `share` est le champ natif d'Odoo : coché,
                                 le compte est un utilisateur PORTAIL, qui
                                 n'accède pas au back-office. Décoché, c'est
                                 un utilisateur interne. -->
                            <field name="share" string="Utilisateur portail"
                                   readonly="1"
                                   help="Calculé d'après les groupes : un compte
                                         appartenant au groupe Portail n'accède
                                         qu'au site et à son espace personnel."/>
                            <field name="active"/>
                        </group>
                    </group>

                    <!-- Mot de passe -->
                    <group string="Sécurité">
                        <field name="password"
                               string="Mot de passe"
                               password="True"
                               invisible="id != False"/>
                        <field name="new_password"
                               string="Nouveau mot de passe"
                               password="True"/>
                    </group>

                    <notebook>
                        <page string="Rôle" name="role">
                            <!-- Champ NATIF `group_ids`, restreint aux seuls
                                 rôles du projet par le domaine sur le
                                 privilège. Sans ce filtre, le widget listerait
                                 les dizaines de groupes d'Odoo (Comptabilité,
                                 Produits, Sondages…), ce qui rend la sélection
                                 illisible.

                                 Un seul champ `group_ids` dans la vue : Odoo
                                 refuse qu'un même champ y figure deux fois.
                                 Pour accorder un droit hors de ces rôles,
                                 passer par Paramètres > Utilisateurs. -->
                            <div class="alert alert-info" role="status">
                                <strong>Un seul rôle à cocher.</strong>
                                L'Administrateur inclut automatiquement les
                                droits du Professeur. L'Étudiant est un compte
                                <em>portail</em> : il ne peut pas être combiné
                                avec les deux autres.
                            </div>
                            <field name="group_ids" nolabel="1"
                                   widget="many2many_checkboxes"
                                   domain="[('privilege_id.name', '=', 'Rôle Smart LMS')]"/>
                        </page>
                    </notebook>



                </sheet>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_lms_user_list" model="ir.ui.view">
        <field name="name">res.users.lms.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Utilisateurs LMS">
                <field name="image_128" widget="image"
                       options="{'size': [32,32]}"/>
                <field name="name"/>
                <field name="login"/>
                <field name="email"/>
                <!-- `share` distingue les comptes portail des comptes
                     internes : c'est l'information la plus utile en liste. -->
                <field name="share" string="Portail" widget="boolean_toggle"
                       readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_lms_users" model="ir.actions.act_window">
        <field name="name">Utilisateurs LMS</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5,0,0),
            (0,0,{'view_mode':'list','view_id':ref('view_lms_user_list')}),
            (0,0,{'view_mode':'form','view_id':ref('view_lms_user_form')}),
        ]"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>