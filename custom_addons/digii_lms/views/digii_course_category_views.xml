<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════
         VUE FORMULAIRE — digii.course.category
    ═══════════════════════════════════════════════════ -->
    <record id="view_digii_course_category_form" model="ir.ui.view">
        <field name="name">digii.course.category.form</field>
        <field name="model">digii.course.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie de Cours">
                <sheet>

                    <!-- ── Smart Button ── -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_channels"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-graduation-cap"
                                invisible="channel_count == 0">
                            <field name="channel_count"
                                   string="Cours"
                                   widget="statinfo"/>
                        </button>
                    </div>

                    <!-- ── Image + Titre ── -->
                    <widget name="web_ribbon"
                            title="Archivé"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="image"
                           widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Nom de la catégorie..."/>
                        </h1>
                    </div>

                    <!-- ── Champs principaux ── -->
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="channel_count" readonly="1"/>
                        </group>
                    </group>

                    <!-- ── Onglets ── -->
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Description de la catégorie..."/>
                        </page>
                        <page string="Cours liés" name="courses">
                            <field name="channel_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="website_published"
                                           string="Publié"/>
                                    <field name="total_slides"
                                           string="Leçons"/>
                                    <field name="members_count"
                                           string="Inscrits"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <!-- ── Chatter ── -->
                <chatter/>

            </form>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════
         VUE LISTE — digii.course.category
    ═══════════════════════════════════════════════════ -->
    <record id="view_digii_course_category_list" model="ir.ui.view">
        <field name="name">digii.course.category.list</field>
        <field name="model">digii.course.category</field>
        <field name="arch" type="xml">
            <list string="Catégories de Cours">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image"
                       options="{'size': [32, 32]}"
                       string=" "/>
                <field name="name"/>
                <field name="channel_count" string="Cours"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════
         VUE KANBAN — digii.course.category
    ═══════════════════════════════════════════════════ -->
    <record id="view_digii_course_category_kanban" model="ir.ui.view">
        <field name="name">digii.course.category.kanban</field>
        <field name="model">digii.course.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="image"/>
                <field name="color"/>
                <field name="channel_count"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <img t-if="record.image.raw_value"
                                 t-att-src="kanban_image('digii.course.category', 'image', record.id.value)"
                                 class="rounded"
                                 style="width:48px; height:48px; object-fit:cover;"/>
                            <div t-else=""
                                 class="rounded d-flex align-items-center justify-content-center bg-light"
                                 style="width:48px; height:48px;">
                                <i class="fa fa-folder fa-2x text-muted"/>
                            </div>
                            <strong class="fs-5">
                                <field name="name"/>
                            </strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge text-bg-primary">
                                <i class="fa fa-graduation-cap me-1"/>
                                <field name="channel_count"/> cours
                            </span>
                            <field name="color" widget="color_picker"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════
         VUE RECHERCHE — digii.course.category
    ═══════════════════════════════════════════════════ -->
    <record id="view_digii_course_category_search" model="ir.ui.view">
        <field name="name">digii.course.category.search</field>
        <field name="model">digii.course.category</field>
        <field name="arch" type="xml">
            <search string="Rechercher une Catégorie">

                <!-- Champs de recherche -->
                <field name="name" string="Nom"/>
                <field name="description" string="Description"/>

                <!-- Filtres -->
                <filter string="Actifs" name="active"
                        domain="[('active', '=', True)]"/>
                <filter string="Archivés" name="archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Avec des Cours" name="has_courses"
                        domain="[('channel_count', '>', 0)]"/>
                <filter string="Sans Cours" name="no_courses"
                        domain="[('channel_count', '=', 0)]"/>


                    <filter string="Couleur" name="group_color"
                            context="{'group_by': 'color'}"/>

            </search>
        </field>
    </record>


    <!-- ═══════════════════════════════════════════════════
         ACTION — digii.course.category
    ═══════════════════════════════════════════════════ -->
    <record id="action_digii_course_category" model="ir.actions.act_window">
        <field name="name">Catégories de Cours</field>
        <field name="res_model">digii.course.category</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_digii_course_category_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première catégorie de cours !
            </p>
            <p>
                Les catégories vous permettent d'organiser
                vos cours par thème ou domaine.
            </p>
        </field>
    </record>

</odoo>