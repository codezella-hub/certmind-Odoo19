<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Groupe utilisateur de l'assistant IA.
            Il est implique automatiquement par le manager Survey (qui gere
            deja la banque de questions et les examens), pour rester coherent
            avec le reste du projet ou tout passe par survey.group_survey_*.
            Un manager Survey a donc l'assistant IA par defaut.
        -->
        <record id="group_exam_ai_user" model="res.groups">
            <field name="name">Assistant IA Examens</field>
        </record>

        <!-- Le manager Survey herite du groupe IA -->
        <record id="survey.group_survey_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('digii_exam_ai_agent.group_exam_ai_user'))]"/>
        </record>

        <!-- Chaque utilisateur ne voit que SES conversations avec l'assistant -->
        <record id="rule_ai_chat_session_own" model="ir.rule">
            <field name="name">Sessions IA : voir uniquement les siennes</field>
            <field name="model_id" ref="model_digii_ai_chat_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('digii_exam_ai_agent.group_exam_ai_user'))]"/>
        </record>
        <record id="rule_ai_chat_message_own" model="ir.rule">
            <field name="name">Messages IA : voir uniquement les siens</field>
            <field name="model_id" ref="model_digii_ai_chat_message"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('digii_exam_ai_agent.group_exam_ai_user'))]"/>
        </record>

    </data>
</odoo>
