<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_ai_generation_session_list" model="ir.ui.view">
            <field name="name">digii.ai.generation.session.list</field>
            <field name="model">digii.ai.generation.session</field>
            <field name="arch" type="xml">
                <list string="Sessions de generation IA"
                      decoration-danger="state == 'error'"
                      decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="source_type"/>
                    <field name="source_course_id"/>
                    <field name="created_question_count"/>
                    <field name="created_rule_count"/>
                    <field name="state"/>
                    <field name="user_id"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="view_ai_generation_session_form" model="ir.ui.view">
            <field name="name">digii.ai.generation.session.form</field>
            <field name="model">digii.ai.generation.session</field>
            <field name="arch" type="xml">
                <form string="Session de generation IA">
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_questions" type="object"
                                    class="oe_stat_button" icon="fa-question-circle"
                                    invisible="created_question_count == 0">
                                <field name="created_question_count" widget="statinfo"
                                       string="Questions"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="source_type"/>
                                <field name="source_course_id"
                                       invisible="source_type != 'course'"/>
                                <field name="user_id"/>
                            </group>
                            <group>
                                <field name="create_date"/>
                                <field name="created_rule_count"/>
                            </group>
                        </group>
                        <group string="Demande">
                            <field name="prompt_user" nolabel="1"/>
                        </group>
                        <group string="Erreur" invisible="state != 'error'">
                            <field name="error_message" nolabel="1"/>
                        </group>
                        <notebook>
                            <page string="Questions generees">
                                <field name="created_question_ids">
                                    <list>
                                        <field name="title"/>
                                        <field name="exam_difficulty"/>
                                        <field name="ai_validation_state"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Regles proposees">
                                <field name="created_rule_proposal_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="exam_category_id"/>
                                        <field name="exam_difficulty"/>
                                        <field name="count"/>
                                        <field name="available_count"/>
                                        <field name="is_feasible" widget="boolean_toggle"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Debug (prompts / reponse)" groups="base.group_no_one">
                                <group string="Prompt systeme">
                                    <field name="prompt_system_used" nolabel="1"/>
                                </group>
                                <group string="Reponse brute">
                                    <field name="raw_response" nolabel="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_ai_generation_session" model="ir.actions.act_window">
            <field name="name">Sessions IA</field>
            <field name="res_model">digii.ai.generation.session</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
