<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- FORM -->
    <record id="exam_certificate_template_view_form" model="ir.ui.view">
        <field name="name">exam.certificate.template.view.form</field>
        <field name="model">exam.certificate.template</field>
        <field name="arch" type="xml">
            <form string="Template de certificat">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex: Template standard"/></h1>
                    </div>
                    <group>
                        <group string="Parametres">
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group string="Apparence">
                            <field name="logo" widget="image" class="oe_avatar"/>
                            <field name="header_color" widget="color"/>
                            <field name="accent_color" widget="color"/>
                            <field name="body_text_color" widget="color"/>
                        </group>
                    </group>
                    <group string="Fond du certificat (mode paysage)">
                        <field name="use_background"/>
                        <field name="background_image" widget="image"
                               invisible="not use_background"
                               options="{'size': [400, 280]}"/>
                        <div class="text-muted" colspan="2"
                             invisible="not use_background">
                            Laissez l'image vide pour utiliser le fond fourni
                            par défaut avec le module (format A4 paysage).
                        </div>
                    </group>
                    <group string="Contenu du certificat">
                        <field name="title_text"/>
                        <field name="body_text"/>
                        <field name="footer_text"/>
                    </group>
                    <group string="Signature">
                        <field name="signatory_name" placeholder="Nom du signataire"/>
                        <field name="signatory_title" placeholder="Titre / Fonction"/>
                        <field name="signature_image" widget="image"
                               options="{'size': [200, 100]}"/>
                    </group>

                    <div class="alert alert-info" role="alert">
                        <strong>Variables disponibles dans le texte du corps :</strong><br/>
                        <code>{candidate}</code> - Nom du candidat<br/>
                        <code>{exam}</code> - Nom de l'examen<br/>
                        <code>{score}</code> - Score obtenu (%)<br/>
                        <code>{date}</code> - Date d'approbation<br/>
                        <code>{certificate_number}</code> - Numero du certificat
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="exam_certificate_template_view_list" model="ir.ui.view">
        <field name="name">exam.certificate.template.view.list</field>
        <field name="model">exam.certificate.template</field>
        <field name="arch" type="xml">
            <list string="Templates de certificat">
                <field name="name"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="title_text"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_exam_certificate_template" model="ir.actions.act_window">
        <field name="name">Templates de certificat</field>
        <field name="res_model">exam.certificate.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creez votre premier template de certificat
            </p>
        </field>
    </record>

</data>
</odoo>
