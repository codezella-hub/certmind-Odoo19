<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- ============================================================ -->
    <!-- Salle d'attente candidat : Caméra + attente autorisation      -->
    <!-- ============================================================ -->
    <template id="portal_waiting_room" name="Salle d'attente examen">
        <t t-call="portal.portal_layout">

            <style>
                :root {
                    --wr-primary: #0F172A;
                    --wr-accent: #2C5F8D;
                    --wr-success: #10B981;
                    --wr-danger: #EF4444;
                    --wr-warning: #F59E0B;
                    --wr-surface: #F1F5F9;
                    --wr-border: #E2E8F0;
                    --wr-text: #1E293B;
                    --wr-text-muted: #64748B;
                    --wr-radius: 16px;
                }

                .wr-container {
                    max-width: 680px;
                    margin: 0 auto;
                    padding: 32px 16px;
                }

                /* Header */
                .wr-header {
                    text-align: center;
                    margin-bottom: 32px;
                }
                .wr-header h2 {
                    font-size: 24px;
                    font-weight: 700;
                    color: var(--wr-primary);
                    margin: 0 0 6px;
                }
                .wr-header p {
                    color: var(--wr-text-muted);
                    font-size: 14px;
                    margin: 0;
                }
                .wr-exam-title {
                    display: inline-block;
                    background: #F2F7FB;
                    color: var(--wr-accent);
                    padding: 6px 16px;
                    border-radius: 8px;
                    font-weight: 600;
                    font-size: 14px;
                    margin-top: 12px;
                }

                /* Video section */
                .wr-video-card {
                    background: #000;
                    border-radius: var(--wr-radius);
                    overflow: hidden;
                    position: relative;
                    aspect-ratio: 4/3;
                    margin-bottom: 24px;
                    border: 2px solid var(--wr-border);
                }
                .wr-video-card video {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }
                .wr-video-card .wr-video-overlay {
                    position: absolute;
                    inset: 0;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    background: rgba(15, 23, 42, 0.85);
                    z-index: 2;
                }
                .wr-video-card .wr-video-overlay.hidden {
                    display: none;
                }
                .wr-video-overlay i {
                    font-size: 48px;
                    margin-bottom: 16px;
                    opacity: 0.6;
                }
                .wr-video-overlay p {
                    font-size: 15px;
                    margin: 0;
                    opacity: 0.8;
                }

                /* Live indicator */
                .wr-live-badge {
                    position: absolute;
                    top: 16px;
                    left: 16px;
                    z-index: 3;
                    display: none;
                    align-items: center;
                    gap: 6px;
                    padding: 5px 12px;
                    background: rgba(239, 68, 68, 0.9);
                    color: #fff;
                    border-radius: 6px;
                    font-size: 11px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    backdrop-filter: blur(8px);
                }
                .wr-live-badge.active { display: inline-flex; }
                .wr-live-dot {
                    width: 6px; height: 6px;
                    background: #fff;
                    border-radius: 50%;
                    animation: live-blink 1s infinite;
                }
                @keyframes live-blink {
                    0%, 100% { opacity: 1; }
                    50% { opacity: 0.2; }
                }

                /* Status panel */
                .wr-status-panel {
                    background: #fff;
                    border: 1px solid var(--wr-border);
                    border-radius: var(--wr-radius);
                    padding: 24px;
                    text-align: center;
                    margin-bottom: 24px;
                }

                .wr-status-icon {
                    width: 64px;
                    height: 64px;
                    border-radius: 50%;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 28px;
                    margin-bottom: 16px;
                }
                .wr-status-icon.waiting {
                    background: #FEF3C7;
                    color: var(--wr-warning);
                }
                .wr-status-icon.authorized {
                    background: #D1FAE5;
                    color: var(--wr-success);
                }
                .wr-status-icon.rejected {
                    background: #FEE2E2;
                    color: var(--wr-danger);
                }

                .wr-status-title {
                    font-size: 18px;
                    font-weight: 700;
                    color: var(--wr-primary);
                    margin: 0 0 6px;
                }
                .wr-status-desc {
                    color: var(--wr-text-muted);
                    font-size: 14px;
                    margin: 0;
                }

                /* Loader animation */
                .wr-loader {
                    display: flex;
                    gap: 6px;
                    justify-content: center;
                    margin-top: 16px;
                }
                .wr-loader span {
                    width: 8px; height: 8px;
                    background: var(--wr-warning);
                    border-radius: 50%;
                    animation: wr-bounce 1.4s infinite ease-in-out both;
                }
                .wr-loader span:nth-child(1) { animation-delay: 0s; }
                .wr-loader span:nth-child(2) { animation-delay: 0.16s; }
                .wr-loader span:nth-child(3) { animation-delay: 0.32s; }
                @keyframes wr-bounce {
                    0%, 80%, 100% { transform: scale(0); }
                    40% { transform: scale(1); }
                }

                /* Start button */
                .btn-start-exam {
                    display: inline-flex;
                    align-items: center;
                    gap: 10px;
                    padding: 14px 36px;
                    background: var(--wr-success);
                    color: #fff;
                    border: none;
                    border-radius: 12px;
                    font-size: 16px;
                    font-weight: 700;
                    cursor: pointer;
                    transition: all 0.2s;
                    margin-top: 16px;
                    text-decoration: none;
                }
                .btn-start-exam:hover {
                    background: #059669;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
                    color: #fff;
                    text-decoration: none;
                }
                .btn-start-exam:disabled, .btn-start-exam.disabled {
                    background: #94A3B8;
                    cursor: not-allowed;
                    transform: none;
                    box-shadow: none;
                    pointer-events: none;
                }

                /* Steps */
                .wr-steps {
                    display: flex;
                    gap: 0;
                    margin-bottom: 28px;
                    background: #fff;
                    border: 1px solid var(--wr-border);
                    border-radius: var(--wr-radius);
                    overflow: hidden;
                }
                .wr-step {
                    flex: 1;
                    padding: 16px 12px;
                    text-align: center;
                    border-right: 1px solid var(--wr-border);
                    transition: all 0.3s;
                }
                .wr-step:last-child { border-right: none; }
                .wr-step.active {
                    background: #F2F7FB;
                }
                .wr-step.done {
                    background: #F0FDF4;
                }
                .wr-step-num {
                    width: 28px; height: 28px;
                    border-radius: 50%;
                    background: var(--wr-border);
                    color: var(--wr-text-muted);
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 12px;
                    font-weight: 700;
                    margin-bottom: 6px;
                }
                .wr-step.active .wr-step-num {
                    background: var(--wr-accent);
                    color: #fff;
                }
                .wr-step.done .wr-step-num {
                    background: var(--wr-success);
                    color: #fff;
                }
                .wr-step-label {
                    font-size: 11px;
                    color: var(--wr-text-muted);
                    font-weight: 600;
                }
                .wr-step.active .wr-step-label { color: var(--wr-accent); }
                .wr-step.done .wr-step-label { color: var(--wr-success); }

                /* Back link */
                .wr-back {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    color: var(--wr-text-muted);
                    font-size: 13px;
                    text-decoration: none;
                    margin-bottom: 24px;
                }
                .wr-back:hover { color: var(--wr-accent); }
            </style>

            <div class="wr-container">
                <!-- Retour -->
                <a href="/my/exams" class="wr-back">
                    <i class="fa fa-arrow-left"/> Retour aux examens
                </a>

                <!-- Header -->
                <div class="wr-header">
                    <h2>Salle d'attente</h2>
                    <p>Activez votre caméra et attendez l'autorisation du surveillant</p>
                    <div class="wr-exam-title">
                        <i class="fa fa-graduation-cap me-1"/>
                        <t t-out="exam.title"/>
                    </div>
                </div>

                <!-- Steps -->
                <div class="wr-steps">
                    <div class="wr-step" id="step-camera">
                        <div class="wr-step-num">1</div>
                        <div class="wr-step-label">Caméra</div>
                    </div>
                    <div class="wr-step" id="step-waiting">
                        <div class="wr-step-num">2</div>
                        <div class="wr-step-label">Vérification</div>
                    </div>
                    <div class="wr-step" id="step-exam">
                        <div class="wr-step-num">3</div>
                        <div class="wr-step-label">Examen</div>
                    </div>
                </div>

                <!-- Video -->
                <div class="wr-video-card">
                    <div class="wr-live-badge" id="liveBadge">
                        <span class="wr-live-dot"/>
                        LIVE
                    </div>
                    <video id="localVideo" autoplay="" muted="" playsinline=""/>
                    <div class="wr-video-overlay" id="videoOverlay">
                        <i class="fa fa-video-camera"/>
                        <p>Cliquez ci-dessous pour activer votre caméra</p>
                    </div>
                </div>

                <!-- Enable camera button -->
                <div class="text-center mb-4" id="cameraButtonWrap">
                    <button class="btn-start-exam" id="btnEnableCamera"
                            onclick="startCamera()">
                        <i class="fa fa-video-camera"/>
                        Activer ma caméra
                    </button>
                </div>

                <!-- Status panel -->
                <div class="wr-status-panel" id="statusPanel" style="display: none;">
                    <div class="wr-status-icon waiting" id="statusIcon">
                        <i class="fa fa-hourglass-half" id="statusIconI"/>
                    </div>
                    <h4 class="wr-status-title" id="statusTitle">En attente du surveillant</h4>
                    <p class="wr-status-desc" id="statusDesc">
                        Votre caméra est active. Le surveillant va vérifier votre identité.
                    </p>
                    <div class="wr-loader" id="statusLoader">
                        <span/><span/><span/>
                    </div>

                    <!-- Start exam button (hidden until authorized) -->
                    <button class="btn-start-exam disabled" id="btnStartExam"
                            style="display: none;"
                            onclick="startExam()">
                        <i class="fa fa-play"/>
                        Commencer l'examen
                    </button>
                </div>
            </div>

            <!-- Config for JS -->
            <div id="waitingRoomConfig"
                 t-att-data-session-id="session.id"
                 t-att-data-session-state="session.state"
                 style="display:none;"> </div>

            <!-- LiveKit client SDK (published as UMD global: LivekitClient) -->
            <script type="text/javascript"
                    src="https://cdn.jsdelivr.net/npm/livekit-client@2.5.9/dist/livekit-client.umd.min.js"> </script>

            <!-- JavaScript : Camera + Polling (external) -->
            <script type="text/javascript" src="/digii_exam_manager/static/src/js/proctoring_candidate.js"> </script>

        </t>
    </template>

</data>
</odoo>