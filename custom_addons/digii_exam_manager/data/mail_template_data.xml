<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- Séquence pour les numéros de certificat -->
    <record id="seq_exam_certificate" model="ir.sequence">
        <field name="name">Certificat d'examen</field>
        <field name="code">exam.certificate</field>
        <field name="prefix">CERT-%(year)s-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Séquence pour les sessions de proctoring -->
    <record id="seq_exam_proctoring_session" model="ir.sequence">
        <field name="name">Session de proctoring</field>
        <field name="code">exam.proctoring.session</field>
        <field name="prefix">PROC-%(year)s-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

</data>

<!-- Templates d'email : bloc mis a jour normalement (non noupdate) pour que
     les ameliorations soient appliquees lors des mises a jour du module.
     Note : si vous personnalisez ces emails dans l'interface Odoo, vos
     modifications seront ecrasees a la prochaine mise a jour du module.

     IMPORTANT (Odoo 19) : le corps (body_html) est rendu par le moteur QWeb.
     Les placeholders dynamiques doivent utiliser <t t-out="..."/> et NON la
     syntaxe {{ }} (qui, elle, ne reste valable que pour le sujet / email_to).

     Charte graphique alignee sur le portail LMS :
       primaire       #2C5F8D
       primaire fonce #1A3A5C
       accent (orange)#E67E22
       accent clair   #F39C12
       creme          #FFF8F0
       texte          #2C3E50
       texte attenue  #6C757D
       bordure        #E0E6ED
-->
<data>

    <!-- ============================================================ -->
    <!-- Email : Certificat approuvé -->
    <!-- ============================================================ -->
    <record id="mail_template_certificate_approved" model="mail.template">
        <field name="name">Examen - Certificat approuvé</field>
        <field name="model_id" ref="model_exam_certificate"/>
        <field name="email_from">{{ (object.create_uid.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="subject">CertMind - Félicitations ! Votre certificat {{ object.name }} est disponible</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;background:#F8F9FA;">
    <table width="600" cellpadding="0" cellspacing="0" style="margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #E0E6ED;">
        <!-- En-tête : gradient bleu portail LMS -->
        <tr>
            <td style="background-color:#1A3A5C;background:linear-gradient(135deg,#2C5F8D 0%,#1A3A5C 100%);padding:34px 30px;text-align:center;">
                <div style="color:#ffffff;font-size:13px;letter-spacing:3px;text-transform:uppercase;opacity:0.85;margin-bottom:6px;">
                    CertMind
                </div>
                <h1 style="color:#ffffff;margin:0;font-size:24px;font-family:'Crimson Pro',Georgia,serif;font-weight:700;">
                    🎓 CertMind — Certificat Approuvé
                </h1>
            </td>
        </tr>
        <tr>
            <td style="padding:30px;color:#2C3E50;">
                <p style="margin:0 0 14px;">Bonjour <strong t-out="object.partner_id.name">Nom du candidat</strong>,</p>

                <p style="margin:0 0 14px;line-height:1.6;">Nous avons le plaisir de vous informer que votre certificat
                   pour l'examen <strong t-out="object.survey_id.title">Titre de l'examen</strong>
                   a été <strong style="color:#2C5F8D;">approuvé</strong>.</p>

                <table width="100%" cellpadding="0" cellspacing="0" style="background:#FFF8F0;border:1px solid #E0E6ED;border-radius:8px;margin:20px 0;">
                    <tr>
                        <td style="padding:10px 14px;color:#6C757D;font-weight:bold;width:45%;">N° Certificat :</td>
                        <td style="padding:10px 14px;color:#2C3E50;font-family:monospace;" t-out="object.name">CERT-2026-00001</td>
                    </tr>
                    <tr>
                        <td style="padding:10px 14px;color:#6C757D;font-weight:bold;">Score obtenu :</td>
                        <td style="padding:10px 14px;color:#2C3E50;">
                            <span style="background:#2C5F8D;color:#fff;padding:2px 12px;border-radius:20px;font-weight:bold;font-size:13px;"><span t-out="'%.1f' % object.score_obtained">0.0</span>%</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:10px 14px;color:#6C757D;font-weight:bold;">Date :</td>
                        <td style="padding:10px 14px;color:#2C3E50;" t-out="object.date_approved.strftime('%d/%m/%Y') if object.date_approved else ''">01/01/2026</td>
                    </tr>
                </table>

                <p style="margin:0 0 6px;line-height:1.6;">Vous pouvez télécharger votre certificat depuis votre espace personnel :</p>

                <div style="text-align:center;margin:26px 0;">
                    <a t-attf-href="#{object.get_base_url()}/my/certificate/#{object.id}"
                       style="background-color:#E67E22;background:linear-gradient(135deg,#E67E22 0%,#F39C12 100%);color:#ffffff;padding:13px 34px;
                              text-decoration:none;border-radius:50px;font-weight:bold;display:inline-block;">
                        Voir mon certificat
                    </a>
                </div>

                <p style="text-align:center;font-size:13px;color:#6C757D;line-height:1.5;">
                    Authenticité vérifiable en ligne :<br/>
                    <a t-att-href="object.verification_url" style="color:#2C5F8D;text-decoration:none;" t-out="object.verification_url">https://.../certificate/verify/xxx</a>
                </p>

                <p style="color:#6C757D;font-size:12px;margin-top:26px;border-top:1px solid #E0E6ED;padding-top:16px;">
                    Cordialement,<br/>
                    <strong style="color:#1A3A5C;">L'équipe CertMind</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Email : Certificat rejeté -->
    <!-- ============================================================ -->
    <record id="mail_template_certificate_rejected" model="mail.template">
        <field name="name">Examen - Certificat rejeté</field>
        <field name="model_id" ref="model_exam_certificate"/>
        <field name="email_from">{{ (object.create_uid.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="subject">CertMind - Information concernant votre examen {{ object.survey_id.title }}</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;background:#F8F9FA;">
    <table width="600" cellpadding="0" cellspacing="0" style="margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #E0E6ED;">
        <tr>
            <td style="background-color:#1A3A5C;background:linear-gradient(135deg,#2C5F8D 0%,#1A3A5C 100%);padding:34px 30px;text-align:center;">
                <div style="color:#ffffff;font-size:13px;letter-spacing:3px;text-transform:uppercase;opacity:0.85;margin-bottom:6px;">
                    CertMind
                </div>
                <h1 style="color:#ffffff;margin:0;font-size:22px;font-family:'Crimson Pro',Georgia,serif;font-weight:700;">
                    Information sur votre certificat
                </h1>
            </td>
        </tr>
        <tr>
            <td style="padding:30px;color:#2C3E50;">
                <p style="margin:0 0 14px;">Bonjour <strong t-out="object.partner_id.name">Nom du candidat</strong>,</p>

                <p style="margin:0 0 14px;line-height:1.6;">Nous vous informons que votre demande de certificat
                   pour l'examen <strong t-out="object.survey_id.title">Titre de l'examen</strong>
                   n'a pas été approuvée.</p>

                <div style="background:#FFF8F0;padding:15px;border-left:4px solid #E67E22;border-radius:6px;margin:20px 0;">
                    <strong style="color:#1A3A5C;">Motif :</strong><br/>
                    <span t-out="object.rejection_reason or 'Non spécifié'">Non spécifié</span>
                </div>

                <p style="margin:0 0 14px;line-height:1.6;">Si vous avez des questions, n'hésitez pas à nous contacter.</p>

                <p style="color:#6C757D;font-size:12px;margin-top:26px;border-top:1px solid #E0E6ED;padding-top:16px;">
                    Cordialement,<br/>
                    <strong style="color:#1A3A5C;">L'équipe CertMind</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>

</data>
</odoo>
