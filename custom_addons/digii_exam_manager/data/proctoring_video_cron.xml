<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          Assemble les videos envoyees par morceaux dont l'envoi s'est
          arrete sans finalisation (onglet ferme, coupure reseau...).
        -->
        <record id="cron_finalize_video_chunks" model="ir.cron">
            <field name="name">Proctoring : assembler les videos envoyees par morceaux</field>
            <field name="model_id" ref="model_exam_proctoring_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_finalize_video_chunks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
