<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="exam_certificate_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">exam.certificate.reject.wizard.view.form</field>
        <field name="model">exam.certificate.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rejeter le certificat">
                <group>
                    <field name="certificate_id" invisible="1"/>
                    <field name="rejection_reason"
                           placeholder="Saisissez le motif de rejet..."
                           widget="text"/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            string="Confirmer le rejet"
                            type="object"
                            class="btn-danger"/>
                    <button string="Annuler"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</data>
</odoo>
