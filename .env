# ─────────────────────────────────────────
# Odoo 19 Docker – Variables d'environnement
# ─────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=odoo

# Odoo
ODOO_ADMIN_PASSWD=admin123

# Port exposé sur le host (8070 pour éviter conflit avec local 8069)
ODOO_PORT=8070
