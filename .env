# ─────────────────────────────────────────────────────────────────
# .env — variables de DÉVELOPPEMENT LOCAL
# ⚠ Listé dans .gitignore : ne jamais le committer.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL (container local)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=odoo

# Connexion Odoo → PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=odoo
DB_SSLMODE=disable

# Odoo
ODOO_ADMIN_PASSWD=admin123
ODOO_WORKERS=0
# log_level : minuscules obligatoires (info, warn, error, debug)
ODOO_LOG_LEVEL=info

# Port exposé sur la machine hôte
ODOO_PORT=8070
